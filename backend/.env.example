# ============================================================
# NovaMart backend — environment template
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env (it is gitignored).
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# Database — paste YOUR MongoDB connection string (no defaults invented).
#   Local MongoDB:  mongodb://127.0.0.1:27017/ecommerce
#   MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecommerce
# Leave empty to run the API without a database (health endpoint reports it).
MONGODB_URI=

# CORS — extra frontend origins allowed to call this API, comma-separated.
# http://localhost:5500 and http://127.0.0.1:5500 are always allowed (dev preview).
CLIENT_ORIGIN=

# Auth — REQUIRED for register/login.
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Razorpay - TEST mode credentials only during development (you paste these).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
